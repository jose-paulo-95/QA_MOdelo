{
  "name": "qa-boilerplate-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Boilerplate Playwright — padrão QA core bancário",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:regressao": "playwright test --project=api --project=desktop --grep @regressao",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}

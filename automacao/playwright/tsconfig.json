{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@support/*": ["tests/support/*"],
      "@api/*": ["tests/api/*"],
      "@e2e/*": ["tests/e2e/*"]
    }
  },
  "include": ["tests/**/*.ts", "playwright.config.ts"]
}
